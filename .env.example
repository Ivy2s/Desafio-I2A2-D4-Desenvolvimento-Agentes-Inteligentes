# Escolha um provider. Se AI_PROVIDER for omitido, o sistema seleciona a chave disponível.
AI_PROVIDER=gemini

# Gemini: obtenha uma chave no Google AI Studio.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_RETRIES=0
GEMINI_MAX_OUTPUT_TOKENS=512

# Groq: para usar este provider, defina AI_PROVIDER=groq e preencha a chave.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Configurações opcionais de confiabilidade.
AGENT_REQUEST_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=0
GROQ_MAX_CONCURRENT_REQUESTS=1
GROQ_MAX_COMPLETION_TOKENS=256
